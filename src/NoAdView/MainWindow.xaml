<Window x:Class="NoAdView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="몽뷰" Width="1100" Height="800" MinWidth="320" MinHeight="240"
        Icon="pack://application:,,,/app.ico"
        Background="#1E1E1E" AllowDrop="True" FontFamily="Malgun Gothic">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Viewport" Grid.Row="0" ClipToBounds="True" Background="#1E1E1E">
            <Canvas x:Name="Stage" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="pack://application:,,,/app.ico" Width="96" Height="96" Opacity="0.85" />
                <TextBlock Margin="0,16,0,0" Foreground="#AAAAAA" FontSize="16" TextAlignment="Center"
                           Text="이미지·폴더·압축 파일을 끌어다 놓거나 Ctrl+O 로 여세요" />
                <TextBlock Margin="0,6,0,0" Foreground="#777777" FontSize="13" TextAlignment="Center"
                           Text="F1 단축키 도움말 · 마우스 오른쪽 버튼 메뉴" />
            </StackPanel>

            <Border x:Name="InfoPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Background="#D8181818" CornerRadius="6" Padding="14,10" Visibility="Collapsed" MaxWidth="420">
                <TextBlock x:Name="InfoText" Foreground="#EEEEEE" FontSize="13" TextWrapping="Wrap" LineHeight="20" />
            </Border>

            <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
                    Background="#E0202020" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="16,9"
                    Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="15" TextWrapping="Wrap" MaxWidth="700" />
            </Border>
        </Grid>

        <ListBox x:Name="Thumbs" Grid.Row="1" Height="132" Visibility="Collapsed"
                 Background="#252525" BorderThickness="0,1,0,0" BorderBrush="#3A3A3A"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel" Focusable="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="Margin" Value="2,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#333333" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3D8BFD" />
                                        <Setter TargetName="Bd" Property="Background" Value="#22406A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="84">
                        <Grid Height="92">
                            <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <TextBlock Text="{Binding Label}" Foreground="#BBBBBB" FontSize="11" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="StatusBar" Grid.Row="2" Background="#2B2B2B" Padding="10,3" BorderThickness="0,1,0,0" BorderBrush="#3A3A3A">
            <DockPanel>
                <TextBlock x:Name="StatusVersion" DockPanel.Dock="Right" Foreground="#777777" FontSize="12" Margin="12,0,0,0" />
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="#AAAAAA" FontSize="12" Margin="12,0,0,0" />
                <TextBlock x:Name="StatusLeft" Foreground="#DDDDDD" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
